{
  "name": "devsecops-tp",
  "version": "1.0.0",
  "private": true,
  "description": "TP DevSecOps",
  "main": "src/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "jest --runInBand --coverage",
    "test:ci": "jest --ci --runInBand --coverage",
    "test:offline": "node --test tests/security.node.test.cjs",
    "lint": "node --check src/app.js && node --check src/security.js && node --check src/index.js"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "supertest": "7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "license": "UNLICENSED"
}
